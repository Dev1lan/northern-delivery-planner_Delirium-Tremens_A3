{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dev1lan/northern-delivery-planner_Delirium-Tremens_A3/result.v2.schema.json",
  "title": "Audited northern delivery result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "strategy",
    "metrics",
    "trips",
    "algorithm_version",
    "input_fingerprint",
    "requirements_fingerprint",
    "data_status",
    "schedule_audit",
    "requirements_status",
    "feasibility_status",
    "requirements",
    "termination_reason",
    "selected_plan_strategy"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "enum": [
        "FCFS",
        "EARLIEST_DUE",
        "OPTIMIZED",
        "SOCIAL_PRIORITY"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivered_on_time_t",
        "delivered_total_t",
        "undelivered_t",
        "completed_trips",
        "violations",
        "vessel_idle_days",
        "fleet_utilization",
        "average_delivery_days",
        "delivered_by_type_t",
        "on_time_by_type_t"
      ],
      "properties": {
        "delivered_on_time_t": {
          "type": "number",
          "minimum": 0
        },
        "delivered_total_t": {
          "type": "number",
          "minimum": 0
        },
        "undelivered_t": {
          "type": "number",
          "minimum": 0
        },
        "completed_trips": {
          "type": "integer",
          "minimum": 0
        },
        "violations": {
          "const": 0
        },
        "vessel_idle_days": {
          "type": "number"
        },
        "fleet_utilization": {
          "type": "number"
        },
        "average_delivery_days": {
          "type": "number",
          "minimum": 0
        },
        "delivered_by_type_t": {
          "$ref": "#/$defs/tonnageByType"
        },
        "on_time_by_type_t": {
          "$ref": "#/$defs/tonnageByType"
        }
      }
    },
    "trips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trip"
      }
    },
    "algorithm_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requirements_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "data_status": {
      "const": "SYNTHETIC"
    },
    "schedule_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "violations"
      ],
      "properties": {
        "status": {
          "const": "PASSED"
        },
        "violations": {
          "const": 0
        }
      }
    },
    "requirements_status": {
      "enum": [
        "SATISFIED",
        "NOT_SATISFIED",
        "NOT_CONFIGURED"
      ]
    },
    "feasibility_status": {
      "enum": [
        "FEASIBLE",
        "INFEASIBLE",
        "UNKNOWN",
        "NOT_CHECKED"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "termination_reason": {
      "enum": [
        "HEURISTIC_COMPLETED",
        "DISPATCH_COMPLETED"
      ]
    },
    "selected_plan_strategy": {
      "enum": [
        "FCFS",
        "EARLIEST_DUE",
        "OPTIMIZED",
        "SOCIAL_PRIORITY"
      ]
    }
  },
  "$defs": {
    "tonnageByType": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trip_id",
        "unit_id",
        "barge_id",
        "tug_id",
        "cargo_id",
        "cargo_type",
        "origin",
        "destination",
        "volume_t",
        "loading_start",
        "departure",
        "arrival",
        "unloading_end",
        "released_at",
        "loaded_draft_m",
        "data_status",
        "source_url",
        "due_date",
        "on_time",
        "events"
      ],
      "properties": {
        "trip_id": {
          "type": "string"
        },
        "unit_id": {
          "type": "string"
        },
        "barge_id": {
          "type": "string"
        },
        "tug_id": {
          "type": "string"
        },
        "cargo_id": {
          "type": "string"
        },
        "cargo_type": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "volume_t": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loading_start": {
          "type": "string"
        },
        "departure": {
          "type": "string"
        },
        "arrival": {
          "type": "string"
        },
        "unloading_end": {
          "type": "string"
        },
        "released_at": {
          "type": "string"
        },
        "due_date": {
          "type": "string"
        },
        "loaded_draft_m": {
          "type": "number"
        },
        "data_status": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "on_time": {
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "segment_id",
        "start",
        "end"
      ],
      "properties": {
        "direction": {
          "enum": [
            "upstream",
            "downstream"
          ]
        },
        "segment_id": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "cargo_types",
        "required_t",
        "deadline",
        "basis",
        "source_status",
        "delivered_by_deadline_t",
        "delivered_total_t",
        "deficit_t",
        "deficit_lower_bound_t",
        "satisfied",
        "reason"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "cargo_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_t": {
          "type": "number",
          "minimum": 0
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "enum": [
            "delivered_by_deadline",
            "delivered_total"
          ]
        },
        "source_status": {
          "type": "string",
          "minLength": 1
        },
        "delivered_by_deadline_t": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "delivered_total_t": {
          "type": "number",
          "minimum": 0
        },
        "deficit_t": {
          "type": "number",
          "minimum": 0
        },
        "deficit_lower_bound_t": {
          "type": "number",
          "minimum": 0
        },
        "satisfied": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            null,
            "INSUFFICIENT_DEMAND",
            "INSUFFICIENT_DEMAND_READY_BY_DEADLINE",
            "INSUFFICIENT_DEMAND_WITH_COMPATIBLE_FLEET",
            "MINIMUM_NOT_MET_BY_SCHEDULE"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requirements_status": {
            "const": "NOT_CONFIGURED"
          }
        }
      },
      "then": {
        "properties": {
          "requirements": {
            "maxItems": 0
          },
          "feasibility_status": {
            "const": "NOT_CHECKED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requirements_status": {
            "const": "SATISFIED"
          }
        }
      },
      "then": {
        "properties": {
          "requirements": {
            "minItems": 1,
            "items": {
              "properties": {
                "satisfied": {
                  "const": true
                },
                "deficit_t": {
                  "const": 0
                }
              }
            }
          },
          "feasibility_status": {
            "const": "FEASIBLE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requirements_status": {
            "const": "NOT_SATISFIED"
          }
        }
      },
      "then": {
        "properties": {
          "requirements": {
            "contains": {
              "properties": {
                "satisfied": {
                  "const": false
                },
                "deficit_t": {
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "feasibility_status": {
            "enum": [
              "UNKNOWN",
              "INFEASIBLE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "feasibility_status": {
            "const": "INFEASIBLE"
          }
        }
      },
      "then": {
        "properties": {
          "requirements": {
            "contains": {
              "properties": {
                "deficit_lower_bound_t": {
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    }
  ]
}
