{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:case-a3:result:1.0.0",
  "title": "Case A3 optimization result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "strategy", "metrics", "trips"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scenario_id": {"type": "string", "minLength": 1},
    "strategy": {"enum": ["FCFS", "EARLIEST_DUE", "OPTIMIZED"]},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivered_on_time_t", "delivered_total_t", "undelivered_t", "completed_trips", "violations", "vessel_idle_days", "fleet_utilization", "average_delivery_days", "delivered_by_type_t", "on_time_by_type_t"],
      "properties": {
        "delivered_on_time_t": {"type": "number", "minimum": 0},
        "delivered_total_t": {"type": "number", "minimum": 0},
        "undelivered_t": {"type": "number", "minimum": 0},
        "completed_trips": {"type": "integer", "minimum": 0},
        "violations": {"type": "integer", "minimum": 0},
        "vessel_idle_days": {"type": "number"},
        "fleet_utilization": {"type": "number"},
        "average_delivery_days": {"type": "number", "minimum": 0},
        "delivered_by_type_t": {"$ref": "#/$defs/tonnageByType"},
        "on_time_by_type_t": {"$ref": "#/$defs/tonnageByType"}
      }
    },
    "trips": {"type": "array", "items": {"$ref": "#/$defs/trip"}}
  },
  "$defs": {
    "tonnageByType": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trip_id", "unit_id", "barge_id", "tug_id", "cargo_id", "cargo_type", "origin", "destination", "volume_t", "loading_start", "departure", "arrival", "unloading_end", "released_at", "loaded_draft_m", "data_status", "source_url", "due_date", "on_time", "events"],
      "properties": {
        "trip_id": {"type": "string"}, "unit_id": {"type": "string"}, "barge_id": {"type": "string"},
        "tug_id": {"type": "string"}, "cargo_id": {"type": "string"}, "cargo_type": {"type": "string"},
        "origin": {"type": "string"}, "destination": {"type": "string"},
        "volume_t": {"type": "number", "exclusiveMinimum": 0},
        "loading_start": {"type": "string"}, "departure": {"type": "string"},
        "arrival": {"type": "string"}, "unloading_end": {"type": "string"},
        "released_at": {"type": "string"}, "due_date": {"type": "string"},
        "loaded_draft_m": {"type": "number"}, "data_status": {"type": "string"},
        "source_url": {"type": "string"}, "on_time": {"type": "boolean"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["direction", "segment_id", "start", "end"],
      "properties": {"direction": {"enum": ["upstream", "downstream"]}, "segment_id": {"type": "string"}, "start": {"type": "string"}, "end": {"type": "string"}}
    }
  }
}
