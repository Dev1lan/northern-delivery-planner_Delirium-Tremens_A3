# Explicit publication set: source, documentation, tests, experiments and demo.
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/PUBLISH_FILES.txt
!/scenario_config.json
!/algorithm_invariants.json
!/result.schema.json
!/optimizer.py
!/generate.py
!/validate.py
!/result_adapter.py
!/scenario_validation.py
!/critical_cargo.py
!/docs/
!/docs/**
!/tests/
!/tests/**
!/experiments/
!/experiments/**
!/data/
/data/*
!/data/demo/
!/data/demo/**
!/data/network_demo/
!/data/network_demo/**
!/data/yakutia_demo/
!/data/yakutia_demo/**
!/data/yakutia/
!/data/yakutia/**
!/results/
/results/*
!/results/demo/
!/results/demo/**

# Third-party PDFs, generated data, old results, environments and caches.
*.[Pp][Dd][Ff]
__pycache__/
*.py[cod]
.venv/
venv*/
.pytest_cache/
.mypy_cache/
*.tmp
*.bak
*~
yakutia/build/
